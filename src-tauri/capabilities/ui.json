{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ui",
  "description": "Browser chrome (tab strip + URL bar). Local app pages only; remote pages get nothing here.",
  "webviews": [
    "main-ui",
    "incognito-*-ui",
    "window-*-ui"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "allow-ui-ready",
    "allow-new-tab",
    "allow-new-incognito-window",
    "allow-close-tab",
    "allow-activate-tab",
    "allow-navigate",
    "allow-go-back",
    "allow-go-forward",
    "allow-reload",
    "allow-toggle-bookmark",
    "allow-find-in-page",
    "allow-suggest",
    "allow-history-search",
    "allow-history-clear",
    "allow-bookmarks-list",
    "allow-bookmark-remove",
    "allow-downloads-list",
    "allow-show-download",
    "allow-tab-menu",
    "allow-group-menu",
    "allow-group-toggle",
    "allow-group-rename",
    "allow-password-save",
    "allow-password-never",
    "allow-password-dismiss",
    "allow-password-menu",
    "allow-passwords-list",
    "allow-password-reveal",
    "allow-password-delete",
    "allow-passwords-import",
    "allow-move-tab",
    "allow-tear-start",
    "allow-tear-move",
    "allow-tear-end",
    "allow-attach-tab",
    "allow-shield-menu",
    "allow-popup-allow",
    "allow-popup-dismiss",
    "allow-trust-menu",
    "allow-update-restart",
    "allow-app-menu"
  ]
}
