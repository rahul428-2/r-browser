{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "R-Browser",
  "version": "0.1.1",
  "identifier": "com.rbrowser.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyQURCNDU1RkM5QjI0ODgKUldTSUpKdjhWYlN0Y2xTUW9JVWxLQlVCSHdyUlU2M0hyenE1RXpwNmVnR084V2JKMWdQZmxoMmcK",
      "endpoints": [
        "https://github.com/rahul428-2/r-browser/releases/latest/download/latest.json"
      ]
    }
  }
}
